# ============================================================================
# Ocean Terminal Configuration (Ghostty-compatible `key = value` format)
# Default location: ~/.config/ocean/config
# Reload live anytime with: Ctrl+Shift+,  or  Ctrl+Shift+R  (or just save file!)
# ============================================================================

# --- Typography & Fonts ---
# Repeat `font-family` to define fallback order (set `font-family = ""` to clear).
# Leave commented to auto-detect the best installed monospace font.
# font-family = Cascadia Code NF
# font-family = JetBrains Mono

# Dedicated Myanmar / Burmese Unicode font (`Padauk`, `Pyidaungsu`, `Noto Sans Myanmar`, etc.)
# Automatically discovered if omitted.
font-family-myanmar = Padauk
myanmar-font-scale = 0.96

# Optional legacy Zawgyi-One display conversion: `off` (default), `auto`, or `force`.
# Toggle live anytime with `Ctrl+Shift+M`.
myanmar-zawgyi = off

font-size = 13.5
font-thicken = false
# font-feature = -calt

# Fine-tune cell dimensions (supports pixels like `2` or percentages like `8%`)
adjust-cell-width = 0
adjust-cell-height = 0
adjust-cursor-thickness = 2

# --- Theme & Colors ---
# 10 Built-in themes (5 Dark + 5 Light — switch live via Right-Click -> Switch Theme):
#   Dark  (5): ocean-dark, tokyo-night, catppuccin-mocha, gruvbox-dark, nord
#   Light (5): ocean-light, tokyo-night-light, catppuccin-latte, gruvbox-light, solarized-light
# (Also loads custom Ghostty theme files from ~/.config/ocean/themes/<name>)
theme = ocean-dark

# Optional individual color overrides:
# background = #0d131a
# foreground = #e6edf3
# cursor-color = #58d1eb
# cursor-text = #0d131a
# selection-background = #243b53
# palette = 0=#151d28

background-opacity = 1.0
cursor-opacity = 1.0
bold-is-bright = false
minimum-contrast = 1.0

# --- Cursor ---
# Values: `block`, `bar`, `underline`, `block_hollow`
cursor-style = block
cursor-style-blink = false

# --- Window & Layout ---
# title = ocean
window-width = 110
window-height = 32
window-padding-x = 10,10
window-padding-y = 8,8
window-padding-balance = true

# System title bar & window decorations (`false` / `none` hides the system title bar)
# Aliases also supported: `gtk-titlebar = false`, `hide-title-bar = true`
window-titlebar = true
window-decoration = true
window-vsync = true

# Tab bar visibility: `auto` (hidden when 1 tab — pure clean UI!), `always`, `never`
window-show-tab-bar = auto

# Neovim-style bottom shortcut & mode status bar (`true` / `false`, toggle live with `Ctrl+Shift+B`)
window-show-status-bar = true

# Top editor menu bar (File / Edit / View / Go / Help) when the editor is open
window-show-menu-bar = true

# Built-in editor keymap: `modeless` (default) or `vim` (Normal / Insert / Visual / Visual-Line)
editor-keymap = modeless

# Restore open editor documents/workspace on launch and recover unsaved buffers after a crash
restore-session = true
crash-recovery = true
# Seconds between crash-recovery snapshots (0 disables)
autosave-interval = 15

# Display backend: `auto` (default), `wayland`, or `x11` (XWayland)
# Under `auto` on Linux, Ocean automatically selects XWayland when running under GNOME
# Wayland to prevent terminal sessions from being killed during screen blank or system sleep.
backend = auto

# --- Updates & Releases ---
# Frequency to check GitHub Releases in background: `daily` (default, 24h cache), `always`, `off`
# When an update is available, a clickable badge appears in the bottom status bar and Context Menu.
auto-update-check = daily

# --- Shell, Scrollback, Mouse & Clipboard ---
# command = /bin/bash
# working-directory = inherit
term = xterm-256color
scrollback-limit = 10000
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3.0
copy-on-select = false
clipboard-trim-trailing-spaces = true
link-url = true

# --- Keybindings (Ghostty syntax: `keybind = mods+key=action`) ---
# Use `keybind = clear` to clear all default bindings, or `=unbind` to remove one.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = alt+shift+left=goto_split:left
keybind = alt+shift+right=goto_split:right
keybind = alt+shift+up=goto_split:up
keybind = alt+shift+down=goto_split:down
keybind = alt+shift+h=goto_split:left
keybind = alt+shift+l=goto_split:right
keybind = alt+shift+k=goto_split:up
keybind = alt+shift+j=goto_split:down
keybind = ctrl+alt+left=resize_split:left,40
keybind = ctrl+alt+right=resize_split:right,40
keybind = ctrl+alt+up=resize_split:up,40
keybind = ctrl+alt+down=resize_split:down,40
keybind = ctrl+alt+h=resize_split:left,40
keybind = ctrl+alt+l=resize_split:right,40
keybind = ctrl+alt+k=resize_split:up,40
keybind = ctrl+alt+j=resize_split:down,40
keybind = alt+shift+equal=equalize_splits
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+m=toggle_myanmar_zawgyi
keybind = shift+f10=toggle_context_menu
keybind = context_menu=toggle_context_menu
keybind = ctrl+shift+p=toggle_context_menu
keybind = ctrl+shift+b=toggle_status_bar
keybind = ctrl+shift+question=show_help
keybind = f11=toggle_fullscreen
